MEMORY
{
    text : origin = $ORIGIN
}

SECTIONS
{
    GROUP:
    {
        $SECTIONS
    } > text

    _stack_end = $LAST_SECTION_SYMBOL + SIZEOF($LAST_SECTION_NAME);
    _stack_addr = (_stack_end + $STACKSIZE + 0x7) & ~0x7;
    // The game's debugger (MetroTRK) stack is 0x5000 bytes, not the default 0x2000:
    // _db_stack_addr = 0x803624C8 and __ArenaLo = 0x803624E0 in the original DOL.
    _db_stack_addr = (_stack_addr + 0x5000);
    _db_stack_end = _stack_addr;
    __ArenaLo = (_db_stack_addr + 0x1f) & ~0x1f;
    __ArenaHi = $ARENAHI;
}

FORCEACTIVE
{
    $FORCEACTIVE
}
